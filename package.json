{
  "name": "factory-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @repo/factory",
    "dev:client": "npm run dev -w @repo/client",
    "build": "npm run build -w @repo/factory -w @repo/client",
    "build:factory": "npm run build -w @repo/factory",
    "build:client": "npm run build -w @repo/client",
    "lint": "eslint",
    "test": "node scripts/test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.116.0",
    "typescript": "^5"
  }
}
