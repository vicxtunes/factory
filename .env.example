# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared receptionist PIN for /intake
INTAKE_PIN=

# 32+ random bytes for signing PIN-session cookies, e.g. `openssl rand -hex 32`
APP_SECRET=

# Google Drive — order/item photo uploads. Service account email + private
# key (from the downloaded JSON key; keep the \n escapes as-is), plus the id
# of a Shared Drive (or a folder shared with the service account as Content
# Manager/Editor) that files get organized into by order/item folder.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
