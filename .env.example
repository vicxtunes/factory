# Supabase project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# Web Push VAPID keypair — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudinary — order/item photo uploads. From the Cloudinary dashboard
# (Settings > API Keys). Uploads are organized into folders per order/item
# (orders/<order_no>/<product>), created automatically — no pre-provisioning
# needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth Web client ID (same one enabled in Supabase → Auth → Providers →
# Google). Enables Google's on-device account picker for "Continue with Google";
# without it the button falls back to the redirect flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
