# Supabase project (runtime/app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI / link helpers for local database tooling
# Create a PAT in Supabase > Account > Access tokens, then run:
#   npx supabase login
#   npx supabase link --project-ref <project-ref>
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
# Optional direct DB connection strings for scripts or migration tooling
DATABASE_URL=
DIRECT_URL=

# 32+ random bytes for signing PIN-session cookies, e.g. `openssl rand -hex 32`
APP_SECRET=

# Web Push VAPID keypair — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudinary — order/item photo uploads. From the Cloudinary dashboard
# (Settings > API Keys). Uploads are organized into folders per order/item
# (orders/<order_no>/<product>), created automatically — no pre-provisioning
# needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared with the factory app: the catalog-change notice it sends here
# (POST /api/catalog-changed) must carry this secret. `openssl rand -hex 32`
REVALIDATE_SECRET=

# Studio photos on Cloudflare R2 (packages/lib/photos/README.md → "R2 setup").
# Account ID: the part before .r2.cloudflarestorage.com in the bucket's S3 API address.
# Keys: R2 → Manage API tokens → Create token (Object Read & Write, this bucket only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aming-studio-photos

# My Business (studios): 1 switches the My Studio area on.
NEXT_PUBLIC_STUDIOS=1
