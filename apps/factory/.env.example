# Supabase project (runtime/app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI / link helpers for local database tooling
# Create a PAT in Supabase > Account > Access tokens, then run:
#   npx supabase login
#   npx supabase link --project-ref <project-ref>
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
# Optional direct DB connection strings for scripts or migration tooling
DATABASE_URL=
DIRECT_URL=

# 32+ random bytes for signing PIN-session cookies, e.g. `openssl rand -hex 32`
APP_SECRET=

# Web Push VAPID keypair — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudinary — order/item photo uploads. From the Cloudinary dashboard
# (Settings > API Keys). Uploads are organized into folders per order/item
# (orders/<order_no>/<product>), created automatically — no pre-provisioning
# needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The client portal app's address, e.g. https://client.example.com — used for
# links to it (share links, invoices, old /client-side URLs) and to tell it
# when the catalog changes. Locally: http://localhost:3001
NEXT_PUBLIC_CLIENT_ORIGIN=
# Shared with the client app; authenticates the catalog-change notice.
REVALIDATE_SECRET=

# Studio review (packages/lib/studio-access): the boss's decision is emailed to
# the studio with Resend. Same values as the client app.
RESEND_API_KEY=
EMAIL_FROM=
# Studio logos on the review page: the same R2 bucket and keys as the client app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
